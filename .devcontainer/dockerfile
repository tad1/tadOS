FROM archlinux
RUN pacman-key --init
RUN pacman --noconfirm -Sy archlinux-keyring
RUN pacman --noconfirm -Syu rustup cargo-edit qemu-system-aarch64 aarch64-linux-gnu-gdb gcc git github-cli less
RUN git config --global alias.yeet push
RUN git config --global alias.yoink pull
RUN rustup default nightly
RUN cargo install cargo-binutils
RUN rustup component add llvm-tools-preview
RUN rustup target add aarch64-unknown-none
RUN rustup target add aarch64-unknown-none-softfloat